# Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=https://rpdwtqvkamfgkehrienf.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
SUPABASE_LEGACY_SECRET=...

# Security & Secrets
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
KEY_ENCRYPTION_SECRET=
JOB_RUNNER_SECRET=

# Application URL (Set this to your Vercel URL in production, e.g. https://your-app.vercel.app)
APP_URL=http://localhost:3000

# Platform AI Provider Keys (for free chapters)
GEMINI_PLATFORM_KEY=
GROQ_PLATFORM_KEY=

# Platform Fallback Configuration
PLATFORM_TEXT_PROVIDERS=gemini,groq
GROQ_TEXT_MODEL=openai/gpt-oss-120b
GEMINI_TEXT_MODEL=gemini-2.5-flash

# Optional Kill-Switches
PLATFORM_DISABLE_GEMINI=false
PLATFORM_DISABLE_GROQ=false
PLATFORM_GENERATION_PAUSED=false

